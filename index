  if(sel.campaign) return 'Campaign: '+shortCamp(sel.campaign);
  return 'All campaigns';
}

/* ---------- audience impression share (donut for selected scope) ---------- */
function renderImpShare(){
  const arr=audArr(state.impSel);
  const map={}; arr.forEach(a=>map[a.name]=a);
  const vals=AUD_ORDER.map(o=>map[o]?map[o].impressions:0);
  const tot=vals.reduce((s,x)=>s+x,0)||1;
  draw('cImpShare','doughnut',{labels:AUD_ORDER.map(o=>o+' Audience'),datasets:[{data:vals,
    backgroundColor:AUD_ORDER.map(o=>AUD_COLOR[o]),borderColor:'#171c24',borderWidth:2}]},
    {responsive:true,maintainAspectRatio:false,cutout:'55%',
     plugins:{legend:{display:false},
       tooltip:{backgroundColor:'#1e2530',borderColor:'#2a323f',borderWidth:1,
         callbacks:{label:c=>`${AUD_ORDER[c.dataIndex]}: ${numShort(c.parsed)} impr (${(c.parsed/tot*100).toFixed(1)}%)`}}}});
  document.getElementById('impScope').textContent=scopeLabel(state.impSel)+' · '+numShort(tot)+' impressions';
}
function audDailyArr(sel){
  if(sel.ad && DATA.aud_daily.ad[sel.ad]) return DATA.aud_daily.ad[sel.ad];
  if(sel.adset && DATA.aud_daily.adset[sel.adset]) return DATA.aud_daily.adset[sel.adset];
  if(sel.campaign && DATA.aud_daily.campaign[sel.campaign]) return DATA.aud_daily.campaign[sel.campaign];
  return DATA.aud_daily.all;
}
function renderImpDaily(){
  const ser=audDailyArr(state.impSel);
  const labels=ser.map(r=>fmtDate(r[0]));
  const mk=(i,name,color)=>({label:name+' Audience',data:ser.map(r=>r[i]),backgroundColor:color,borderColor:'#171c24',borderWidth:0,stack:'a',borderRadius:2});
  draw('cImpDaily','bar',{labels,datasets:[mk(1,'Engaged','#6c8cff'),mk(2,'Existing','#21c997'),mk(3,'New','#ffb454')]},
    baseOpts({plugins:{legend:{display:false},tooltip:{backgroundColor:'#1e2530',borderColor:'#2a323f',borderWidth:1,
      callbacks:{label:c=>`${c.dataset.label}: ${numShort(c.parsed.y)} impr`}}},
      scales:{x:{stacked:true,ticks:{color:'#9aa7b8',font:{size:9},maxTicksLimit:14},grid:{color:'#1c232e'}},
              y:{stacked:true,ticks:{color:'#9aa7b8',font:{size:10},callback:v=>numShort(v)},grid:{color:'#1c232e'}}}}));
}
function renderImpAll(){ renderImpShare(); renderImpDaily(); }

function draw(id,type,data,options){
  if(charts[id])charts[id].destroy();
  charts[id]=new Chart(document.getElementById(id),{type,data,options});
}
function shortCamp(n){ return n.split('_')[0]; }   /* campaign code only, e.g. IB03 / PS04 */

/* ---------- day-by-day trend tool ---------- */
function buildTrendPills(){
  const box=document.getElementById('trendPills');
  box.innerHTML='<span class="mini">Metrics:</span>'+Object.keys(METRICS).map(k=>
    `<button class="pill ${state.trend.includes(k)?'active':''}" data-m="${k}">${METRICS[k].t}</button>`).join('');
  box.querySelectorAll('[data-m]').forEach(b=>b.onclick=()=>{
    const k=b.dataset.m, i=state.trend.indexOf(k);
    if(i>=0){ if(state.trend.length>1) state.trend.splice(i,1); }
    else state.trend.push(k);
    buildTrendPills(); renderTrend();
  });
}
function renderTrend(){
  const rows=filteredDailyRows();
  const labels=rows.map(r=>fmtDate(r.date));
  const useR=state.trend.some(k=>METRICS[k].axis==='R');
  const useL=state.trend.some(k=>METRICS[k].axis==='L');
  const ds=state.trend.map(k=>{
    const M=METRICS[k];
    return {label:M.t,data:rows.map(r=>r[k]),borderColor:M.color,
      backgroundColor:M.color+'22',tension:.3,pointRadius:2,pointHoverRadius:5,borderWidth:2,
      fill:false,yAxisID:M.axis==='R'?'yR':'yL'};
  });
  const scales={x:{ticks:{color:'#9aa7b8',font:{size:10},maxTicksLimit:14},grid:{color:'#1c232e'}}};
  if(useL) scales.yL={position:'left',ticks:{color:'#9aa7b8',font:{size:10},callback:v=>numShort(v)},grid:{color:'#1c232e'}};
  if(useR) scales.yR={position:'right',ticks:{color:'#9aa7b8',font:{size:10}},grid:{drawOnChartArea:!useL}};
  draw('cTrend','line',{labels,datasets:ds},baseOpts({scales}));
}

/* ---------- color scale ---------- */
function heat(val,min,max,invert){
  if(max===min) return '#ffb454';
  let t=(val-min)/(max-min); if(invert)t=1-t;
  const c=t<.5? lerp([255,107,107],[255,180,84],t*2) : lerp([255,180,84],[33,201,151],(t-.5)*2);
  return `rgb(${c[0]},${c[1]},${c[2]})`;
}
const lerp=(a,b,t)=>a.map((v,i)=>Math.round(v+(b[i]-v)*t));

/* ---------- tables ---------- */
function tableHTML(cols,rows){
  const head='<thead><tr>'+cols.map(c=>`<th data-k="${c.k}">${c.t}</th>`).join('')+'</tr></thead>';
  const body='<tbody>'+rows.map(r=>'<tr>'+cols.map(c=>`<td>${c.f?c.f(r[c.k],r):r[c.k]}</td>`).join('')+'</tr>').join('')+'</tbody>';
  return head+body;
}

/* Audience Segment Performance — entity selectable (Campaign / Ad Set / Ad), incl. Conv. Value */
function renderAudTable(){
  const rows=audArr(state.audSel).slice().sort((a,b)=>b.spend-a.spend);
  const cols=[
    {k:'name',t:'Segment'},
    {k:'spend',t:'Spend',f:inrShort},
    {k:'revenue',t:'Conv. Value',f:inrShort},
    {k:'roas',t:'ROAS',f:x2},
    {k:'conversions',t:'Conv',f:v=>Math.round(v).toLocaleString('en-IN')},
    {k:'conv_rate',t:'CvR',f:pct},{k:'cpc',t:'CPC',f:INR},{k:'ctr',t:'CTR',f:pct}
  ];
  document.getElementById('tAud').innerHTML=tableHTML(cols,rows);
  document.getElementById('audScope').textContent=scopeLabel(state.audSel);
}

/* Creative Type Performance — incl. Conv. Value */
function renderCreTable(){
  const rows=DATA.creative_types.slice().sort((a,b)=>b.spend-a.spend);
  const cols=[
    {k:'name',t:'Creative'},
    {k:'spend',t:'Spend',f:inrShort},
    {k:'revenue',t:'Conv. Value',f:inrShort},
    {k:'roas',t:'ROAS',f:x2},
    {k:'conversions',t:'Conv',f:v=>Math.round(v).toLocaleString('en-IN')},
    {k:'conv_rate',t:'CvR',f:pct},{k:'cpc',t:'CPC',f:INR},{k:'ctr',t:'CTR',f:pct}
  ];
  document.getElementById('tCre').innerHTML=tableHTML(cols,rows);
}

function renderHeat(){
  const rows=adsetTotals();
  if(!rows.length){document.getElementById('tHeat').innerHTML='<tbody><tr><td>No data for this selection</td></tr></tbody>';return;}
  const metricsCols=[
    {k:'spend',t:'Spend',f:inrShort,invert:false},
    {k:'revenue',t:'Conv. Value',f:inrShort,invert:false},
    {k:'roas',t:'ROAS',f:x2,invert:false},
    {k:'conv_rate',t:'Conv Rate',f:pct,invert:false},
    {k:'cost_per_conv',t:'Cost/Conv',f:INR,invert:true},
    {k:'cpc',t:'CPC',f:INR,invert:true},
    {k:'ctr',t:'CTR',f:pct,invert:false},
    {k:'cpm',t:'CPM',f:INR,invert:true},
  ];
  const ranges={};
  metricsCols.forEach(c=>{const vs=rows.map(r=>r[c.k]);ranges[c.k]=[Math.min(...vs),Math.max(...vs)];});
  rows.sort((a,b)=>b.spend-a.spend);
  const head='<thead><tr><th>Ad Set</th><th>Conv</th>'+metricsCols.map(c=>`<th>${c.t}</th>`).join('')+'</tr></thead>';
  const body='<tbody>'+rows.map(r=>{
    const cells=metricsCols.map(c=>{
      const col=heat(r[c.k],ranges[c.k][0],ranges[c.k][1],c.invert);
      return `<td><span class="heatcell" style="background:${col};padding:2px 7px">${c.f(r[c.k])}</span></td>`;
    }).join('');
    return `<tr><td><span class="clickable" data-aset="${r.name}" title="${r.name}">${r.name}</span><div class="mini">${shortCamp(r.campaign)}</div></td><td>${Math.round(r.conversions)}</td>${cells}</tr>`;
  }).join('')+'</tbody>';
  const t=document.getElementById('tHeat'); t.innerHTML=head+body;
  t.querySelectorAll('[data-aset]').forEach(el=>el.onclick=()=>{drillTo(el.closest('tr').querySelector('.mini').textContent,el.dataset.aset);});
}

/* ---------- ad-level explorer ---------- */
function renderAds(){
  let rows=DATA.ads;
  if(state.drillCampaign) rows=rows.filter(a=>a.campaign===state.drillCampaign);
  if(state.drillAdset) rows=rows.filter(a=>a.adset===state.drillAdset);
  if(state.creative) rows=rows.filter(a=>a.creative===state.creative);
  if(state.adSearch){const q=state.adSearch.toLowerCase();rows=rows.filter(a=>a.name.toLowerCase().includes(q));}
  const sk=state.adSort.k,dir=state.adSort.dir;
  rows=rows.slice().sort((a,b)=>{const x=a[sk],y=b[sk];return (typeof x==='string')?x.localeCompare(y)*dir:(x-y)*dir;});
  const show=rows.slice(0,400);
  const cols=[
    {k:'name',t:'Ad Name',f:v=>`<span title="${v}">${v}</span>`},
    {k:'creative',t:'Type',f:v=>`<span class="tag ${v==='Video'?'v':v==='Image'?'i':'c'}">${v}</span>`},
    {k:'spend',t:'Spend',f:inrShort},{k:'revenue',t:'Conv. Value',f:inrShort},
    {k:'roas',t:'ROAS',f:x2},{k:'conversions',t:'Conv',f:v=>Math.round(v)},
    {k:'conv_rate',t:'CvR',f:pct},{k:'cpc',t:'CPC',f:INR},
    {k:'ctr',t:'CTR',f:pct},{k:'cpm',t:'CPM',f:INR},{k:'impressions',t:'Impr',f:numShort}
  ];
  const t=document.getElementById('tAds'); t.innerHTML=tableHTML(cols,show);
  markSort(t,state.adSort);
  t.querySelectorAll('th').forEach(th=>th.onclick=()=>{const k=th.dataset.k;state.adSort.dir=(state.adSort.k===k)?-state.adSort.dir:-1;state.adSort.k=k;renderAds();});
  document.getElementById('adCount').textContent=`${rows.length} ads`+(rows.length>400?' (showing top 400)':'');
  renderCrumb();
}
function renderCrumb(){
  const c=document.getElementById('crumb');
  let h='<span class="clickable" id="cbAll">All ads</span>';
  if(state.drillCampaign) h+=` › <b>${shortCamp(state.drillCampaign)}</b>`;
  if(state.drillAdset) h+=` › <b>${state.drillAdset}</b>`;
  c.innerHTML=h;
  const all=document.getElementById('cbAll'); if(all) all.onclick=()=>{state.drillCampaign='';state.drillAdset='';renderAds();};
}
function drillTo(camp,aset){
  state.drillCampaign = DATA.ads.some(a=>a.campaign===camp) ? camp
    : (camp && camp.startsWith('IB03')) ? 'IB03_Sales_TOF_Multi-Categories_Video_03112025_VCPR'
    : (camp && camp.startsWith('PS04')) ? 'PS04_Sales_TOF_Multi-Category_Static_04112025_ICPR' : '';
  state.drillAdset=aset||'';
  document.getElementById('tAds').scrollIntoView({behavior:'smooth',block:'center'});
  renderAds();
}
function markSort(t,s){t.querySelectorAll('th').forEach(th=>{th.classList.remove('sort-asc','sort-desc');if(th.dataset.k===s.k)th.classList.add(s.dir>0?'sort-asc':'sort-desc');});}

/* ---------- orchestration ---------- */
function renderAll(){
  renderKPIs();renderTrend();renderCharts();
  renderAudTable();
  renderCreTable();
  renderHeat();renderAds();
  document.getElementById('hdrSub').textContent=`${DATA.meta.n_campaigns} campaigns · ${DATA.meta.n_adsets} ad sets · ${DATA.meta.n_ads.toLocaleString('en-IN')} ads · INR`;
  document.getElementById('hdrRange').textContent=`Showing ${state.from} → ${state.to}`+(state.campaign?` · ${shortCamp(state.campaign)}`:'')+(state.adset?` · ${state.adset}`:'');
  document.getElementById('footMeta').textContent=`Full data range ${DATA.meta.date_min} → ${DATA.meta.date_max} · generated ${DATA.meta.generated}`;
}

/* ---------- init ---------- */
function populateAdsets(){
  const a=document.getElementById('fAdset');
  const camp=document.getElementById('fCampaign').value;
  const list=DATA.adsets.filter(s=>!camp||s.campaign===camp);
  a.innerHTML='<option value="">All ad sets</option>'+list.map(s=>`<option value="${s.name}">${s.name}</option>`).join('');
  if(![...a.options].some(o=>o.value===state.adset)) state.adset='';
  a.value=state.adset;
}
/* cascading Campaign Name ▸ Ad Set Name ▸ Ad Name selectors (used by both audience sections) */
function fillCampSel(el){el.innerHTML='<option value="">All campaigns</option>'+DATA.campaigns.map(c=>`<option value="${c.name}">${shortCamp(c.name)}</option>`).join('');}
function fillAdsetSel(el,camp){const list=DATA.adsets.filter(s=>!camp||s.campaign===camp);el.innerHTML='<option value="">All ad sets</option>'+list.map(s=>`<option value="${s.name}">${s.name}</option>`).join('');}
function fillAdSel(el,camp,aset){let list=DATA.ads;if(aset)list=list.filter(a=>a.adset===aset);else if(camp)list=list.filter(a=>a.campaign===camp);list=list.slice().sort((a,b)=>b.spend-a.spend);el.innerHTML='<option value="">All ads</option>'+list.map(a=>`<option value="${a.name}">${a.name}</option>`).join('');}
function setupAudGroup(ids,sel,onChange){
  const cE=document.getElementById(ids.camp),aE=document.getElementById(ids.aset),dE=document.getElementById(ids.ad);
  fillCampSel(cE);fillAdsetSel(aE,'');fillAdSel(dE,'','');
  cE.onchange=()=>{sel.campaign=cE.value;sel.adset='';sel.ad='';fillAdsetSel(aE,sel.campaign);aE.value='';fillAdSel(dE,sel.campaign,'');dE.value='';onChange();};
  aE.onchange=()=>{sel.adset=aE.value;sel.ad='';fillAdSel(dE,sel.campaign,sel.adset);dE.value='';onChange();};
  dE.onchange=()=>{sel.ad=dE.value;onChange();};
}
function init(){
  const f=document.getElementById('fCampaign');
  DATA.campaigns.forEach(c=>{const o=document.createElement('option');o.value=c.name;o.textContent=shortCamp(c.name);f.appendChild(o);});
  populateAdsets();
  buildTrendPills();
  f.onchange=()=>{ populateAdsets(); };
  setupAudGroup({camp:'impCampaign',aset:'impAdset',ad:'impAd'},state.impSel,renderImpAll);
  setupAudGroup({camp:'audCampaign',aset:'audAdset',ad:'audAd'},state.audSel,renderAudTable);
  document.getElementById('fFrom').value=state.from;
  document.getElementById('fFrom').min=DATA.meta.date_min;document.getElementById('fFrom').max=DATA.meta.date_max;
  document.getElementById('fTo').value=state.to;
  document.getElementById('fTo').min=DATA.meta.date_min;document.getElementById('fTo').max=DATA.meta.date_max;

  document.getElementById('apply').onclick=()=>{
    state.from=document.getElementById('fFrom').value||DATA.meta.date_min;
    state.to=document.getElementById('fTo').value||DATA.meta.date_max;
    state.campaign=document.getElementById('fCampaign').value;
    state.adset=document.getElementById('fAdset').value;
    renderAll();
  };
  document.getElementById('reset').onclick=()=>{
    state.from=DATA.meta.date_min;state.to=DATA.meta.date_max;state.campaign='';state.adset='';state.drillCampaign='';state.drillAdset='';state.creative='';state.adSearch='';
    document.getElementById('fFrom').value=state.from;document.getElementById('fTo').value=state.to;
    document.getElementById('fCampaign').value='';document.getElementById('fQuick').value='all';
    populateAdsets();
    state.impSel={campaign:'',adset:'',ad:''};state.audSel={campaign:'',adset:'',ad:''};
    setupAudGroup({camp:'impCampaign',aset:'impAdset',ad:'impAd'},state.impSel,renderImpAll);
    setupAudGroup({camp:'audCampaign',aset:'audAdset',ad:'audAd'},state.audSel,renderAudTable);
    document.getElementById('adSearch').value='';
    document.querySelectorAll('.pill[data-cre]').forEach(p=>p.classList.toggle('active',p.dataset.cre===''));
    renderAll();
  };
  document.getElementById('fQuick').onchange=e=>{
    const v=e.target.value;
    if(v==='all'){state.from=DATA.meta.date_min;}
    else{const d=new Date(DATA.meta.date_max);d.setDate(d.getDate()-(+v-1));state.from=d.toISOString().slice(0,10);}
    state.to=DATA.meta.date_max;
    document.getElementById('fFrom').value=state.from;document.getElementById('fTo').value=state.to;
    renderAll();
  };
  document.getElementById('adSearch').oninput=e=>{state.adSearch=e.target.value;renderAds();};
  document.querySelectorAll('.pill[data-cre]').forEach(p=>p.onclick=()=>{
    document.querySelectorAll('.pill[data-cre]').forEach(x=>x.classList.remove('active'));p.classList.add('active');
    state.creative=p.dataset.cre;renderAds();
  });
  renderAll();
}
init();
</script>
