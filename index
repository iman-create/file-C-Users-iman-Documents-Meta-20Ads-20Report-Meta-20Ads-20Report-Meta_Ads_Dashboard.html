<script>
/* ---------- helpers ---------- */
const INR = n => '₹'+Math.round(n).toLocaleString('en-IN');
function inrShort(n){
  if(n>=1e7) return '₹'+(n/1e7).toFixed(2)+' Cr';
  if(n>=1e5) return '₹'+(n/1e5).toFixed(2)+' L';
  if(n>=1e3) return '₹'+(n/1e3).toFixed(1)+'K';
  return '₹'+Math.round(n);
}
const numShort = n => n>=1e7?(n/1e7).toFixed(2)+'Cr':n>=1e5?(n/1e5).toFixed(2)+'L':n>=1e3?(n/1e3).toFixed(1)+'K':Math.round(n).toLocaleString('en-IN');
const pct = n => n.toFixed(2)+'%';
const x2 = n => n.toFixed(2)+'x';

function deriveMetrics(items){
  let s=0,r=0,im=0,cl=0,cv=0,re=0;
  items.forEach(o=>{s+=o.spend;r+=o.revenue;im+=o.impressions;cl+=o.clicks;cv+=o.conversions;re+=(o.reach||0);});
  return {spend:s,revenue:r,impressions:im,clicks:cl,conversions:cv,reach:re,
    roas:s?r/s:0, cpc:cl?s/cl:0, cpm:im?s/im*1000:0, ctr:im?cl/im*100:0,
    conv_rate:cl?cv/cl*100:0, cost_per_conv:cv?s/cv:0};
}

/* ---------- state ---------- */
let charts={};
let state={from:DATA.meta.date_min,to:DATA.meta.date_max,campaign:'',adset:'',creative:'',adSearch:'',drillCampaign:'',drillAdset:'',adSort:{k:'spend',dir:-1},
  impSel:{campaign:'',adset:'',ad:''},audSel:{campaign:'',adset:'',ad:''},trend:['spend','roas']};

/* metric registry for the day-by-day trend tool */
const METRICS={
  spend:{t:'Spend (₹)',axis:'L',color:'#6c8cff',fmt:numShort},
  revenue:{t:'Purchase Value (₹)',axis:'L',color:'#21c997',fmt:numShort},
  conversions:{t:'Conversions',axis:'L',color:'#ffb454',fmt:v=>Math.round(v)},
  clicks:{t:'Clicks',axis:'L',color:'#b78bff',fmt:numShort},
  impressions:{t:'Impressions',axis:'L',color:'#4dd0e1',fmt:numShort},
  reach:{t:'Reach',axis:'L',color:'#f48fb1',fmt:numShort},
  roas:{t:'ROAS (x)',axis:'R',color:'#21c997',fmt:v=>v.toFixed(2)},
  ctr:{t:'CTR (%)',axis:'R',color:'#6c8cff',fmt:v=>v.toFixed(2)},
  conv_rate:{t:'Conv Rate (%)',axis:'R',color:'#ffb454',fmt:v=>v.toFixed(2)},
  cpc:{t:'CPC (₹)',axis:'R',color:'#ff6b6b',fmt:v=>v.toFixed(2)},
  cpm:{t:'CPM (₹)',axis:'R',color:'#b78bff',fmt:v=>v.toFixed(0)},
  cost_per_conv:{t:'Cost / Conv (₹)',axis:'R',color:'#f48fb1',fmt:v=>v.toFixed(0)}
};

/* ---------- filtered daily (per selected campaign / ad set + date) ---------- */
function filteredDailyRows(){
  const out=[];
  if(state.adset){
    const arr=DATA.adsets_daily[state.adset]||[];
    arr.forEach(o=>{ if(o.date<state.from||o.date>state.to) return; out.push({date:o.date,...deriveMetrics([o])}); });
    out.sort((a,b)=>a.date.localeCompare(b.date));
    return out;
  }
  DATA.daily_by_campaign.forEach(d=>{
    if(d.date<state.from||d.date>state.to) return;
    let rows=Object.entries(d.campaigns);
    if(state.campaign) rows=rows.filter(([c])=>c===state.campaign);
    if(!rows.length) return;
    const m=deriveMetrics(rows.map(([,v])=>v));
    out.push({date:d.date,...m});
  });
  return out;
}
function campaignTotals(){
  const map={};
  DATA.daily_by_campaign.forEach(d=>{
    if(d.date<state.from||d.date>state.to) return;
    Object.entries(d.campaigns).forEach(([c,v])=>{
      if(state.campaign && c!==state.campaign) return;
      (map[c]=map[c]||[]).push(v);
    });
  });
  return Object.entries(map).map(([name,arr])=>({name,...deriveMetrics(arr)}));
}
function adsetTotals(){
  const map={};
  for(const [name,arr] of Object.entries(DATA.adsets_daily)){
    const camp=(DATA.adsets.find(a=>a.name===name)||{}).campaign||'';
    if(state.campaign && camp!==state.campaign) continue;
    const sel=arr.filter(o=>o.date>=state.from&&o.date<=state.to);
    if(!sel.length) continue;
    map[name]={name,campaign:camp,...deriveMetrics(sel)};
  }
  return Object.values(map);
}

/* ---------- KPI cards ---------- */
function renderKPIs(){
  const rows=filteredDailyRows();
  const m=deriveMetrics(rows);
  const days=rows.length||1;
  const cards=[
    ['Total Spend',inrShort(m.spend),INR(m.spend)],
    ['Purchase Value',inrShort(m.revenue),'ROAS '+x2(m.roas)],
    ['Avg ROAS',x2(m.roas),'rev / spend'],
    ['Conversions',Math.round(m.conversions).toLocaleString('en-IN'),'₹'+Math.round(m.cost_per_conv).toLocaleString('en-IN')+' / conv'],
    ['Avg CPC',INR(m.cpc),'link clicks'],
    ['CTR',pct(m.ctr),numShort(m.clicks)+' clicks'],
    ['CPM',INR(m.cpm),numShort(m.impressions)+' impr'],
    ['Conv. Rate',pct(m.conv_rate),'of link clicks'],
    ['Avg Daily Spend',inrShort(m.spend/days),days+' days'],
    ['Reach',numShort(m.reach),'people'],
  ];
  document.getElementById('kpis').innerHTML=cards.map(c=>
    `<div class="kpi"><div class="k">${c[0]}</div><div class="v">${c[1]}</div><div class="d">${c[2]}</div></div>`).join('');
}

/* ---------- charts ---------- */
const baseOpts=(extra={})=>Object.assign({
  responsive:true,maintainAspectRatio:false,
  interaction:{mode:'index',intersect:false},
  plugins:{legend:{labels:{color:'#9aa7b8',boxWidth:12,font:{size:11}}},
    tooltip:{backgroundColor:'#1e2530',borderColor:'#2a323f',borderWidth:1}},
  scales:{x:{ticks:{color:'#9aa7b8',font:{size:10},maxRotation:0,autoSkip:true,maxTicksLimit:12},grid:{color:'#1c232e'}},
          y:{ticks:{color:'#9aa7b8',font:{size:10}},grid:{color:'#1c232e'}}}
},extra);

function fmtDate(d){return d.slice(5).replace('-','/');}

function renderCharts(){
  const rows=filteredDailyRows();
  const labels=rows.map(r=>fmtDate(r.date));
  // spend & revenue
  draw('cSpend','bar',{labels,datasets:[
    {label:'Spend',data:rows.map(r=>r.spend),backgroundColor:'#6c8cff',borderRadius:4,order:2},
    {type:'line',label:'Purchase Value',data:rows.map(r=>r.revenue),borderColor:'#21c997',backgroundColor:'rgba(33,201,151,.1)',tension:.3,fill:true,pointRadius:0,borderWidth:2,order:1,yAxisID:'y1'}
  ]},baseOpts({scales:{x:{ticks:{color:'#9aa7b8',font:{size:10},maxTicksLimit:12},grid:{color:'#1c232e'}},
    y:{position:'left',ticks:{color:'#9aa7b8',font:{size:10},callback:v=>numShort(v)},grid:{color:'#1c232e'}},
    y1:{position:'right',ticks:{color:'#21c997',font:{size:10},callback:v=>numShort(v)},grid:{drawOnChartArea:false}}}}));

  // pie budget
  const ct=campaignTotals().sort((a,b)=>b.spend-a.spend);
  draw('cPie','doughnut',{labels:ct.map(c=>shortCamp(c.name)),datasets:[{data:ct.map(c=>c.spend),
    backgroundColor:['#6c8cff','#21c997','#ffb454','#ff6b6b','#b78bff','#4dd0e1'],borderColor:'#171c24',borderWidth:2}]},
    {responsive:true,maintainAspectRatio:false,plugins:{legend:{position:'bottom',labels:{color:'#9aa7b8',font:{size:11},padding:10}},
      tooltip:{callbacks:{label:c=>shortCamp(ct[c.dataIndex].name)+': '+inrShort(c.parsed)+' ('+(c.parsed/ct.reduce((s,x)=>s+x.spend,0)*100).toFixed(1)+'%)'}}}});

  // rates
  draw('cRates','line',{labels,datasets:[
    {label:'CTR %',data:rows.map(r=>r.ctr),borderColor:'#6c8cff',backgroundColor:'rgba(108,140,255,.1)',tension:.3,fill:true,pointRadius:0,borderWidth:2},
    {label:'Conv. Rate %',data:rows.map(r=>r.conv_rate),borderColor:'#ffb454',tension:.3,pointRadius:0,borderWidth:2}
  ]},baseOpts());

  // roas & cpc
  draw('cRoas','line',{labels,datasets:[
    {label:'ROAS (x)',data:rows.map(r=>r.roas),borderColor:'#21c997',backgroundColor:'rgba(33,201,151,.1)',tension:.3,fill:true,pointRadius:0,borderWidth:2},
    {label:'CPC (₹)',data:rows.map(r=>r.cpc),borderColor:'#ff6b6b',tension:.3,pointRadius:0,borderWidth:2,yAxisID:'y1'}
  ]},baseOpts({scales:{x:{ticks:{color:'#9aa7b8',font:{size:10},maxTicksLimit:12},grid:{color:'#1c232e'}},
    y:{position:'left',ticks:{color:'#21c997',font:{size:10}},grid:{color:'#1c232e'}},
    y1:{position:'right',ticks:{color:'#ff6b6b',font:{size:10}},grid:{drawOnChartArea:false}}}}));

  renderImpAll();
}

