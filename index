<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Littlebox · Meta Ads Performance Dashboard</title>
<script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.4.1/chart.umd.min.js"></script>
<style>
  :root{
    --bg:#0e1116; --panel:#171c24; --panel2:#1e2530; --line:#2a323f;
    --txt:#e8edf3; --muted:#9aa7b8; --accent:#6c8cff; --accent2:#21c997;
    --warn:#ffb454; --bad:#ff6b6b; --good:#21c997;
    --chip:#232b37;
    --aud1:#6c8cff; --aud2:#21c997; --aud3:#ffb454;
  }
  *{box-sizing:border-box}
  body{margin:0;background:var(--bg);color:var(--txt);font:14px/1.45 -apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,Helvetica,Arial,sans-serif}
  a{color:var(--accent)}
  header{padding:18px 24px;border-bottom:1px solid var(--line);display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:12px;background:linear-gradient(180deg,#141a22,#0e1116)}
  .brand{display:flex;align-items:center;gap:12px}
  .logo{width:34px;height:34px;border-radius:8px;background:linear-gradient(135deg,var(--accent),var(--accent2));display:flex;align-items:center;justify-content:center;font-weight:800;color:#0b0e13}
  h1{font-size:18px;margin:0;font-weight:700;letter-spacing:.2px}
  .sub{color:var(--muted);font-size:12px}
  .wrap{padding:20px 24px;max-width:1500px;margin:0 auto}
  /* filter bar */
  .filters{display:flex;gap:14px;flex-wrap:wrap;align-items:flex-end;background:var(--panel);border:1px solid var(--line);border-radius:12px;padding:14px 16px;margin-bottom:18px}
  .filters label{display:flex;flex-direction:column;gap:5px;font-size:11px;color:var(--muted);text-transform:uppercase;letter-spacing:.5px}
  .filters input,.filters select{background:var(--panel2);border:1px solid var(--line);color:var(--txt);padding:7px 9px;border-radius:8px;font-size:13px;min-width:150px}
  .btn{background:var(--accent);color:#0b0e13;border:none;padding:8px 16px;border-radius:8px;font-weight:700;cursor:pointer;font-size:13px}
  .btn.ghost{background:transparent;color:var(--muted);border:1px solid var(--line)}
  .btn:hover{filter:brightness(1.08)}
  .cardsel{background:var(--panel2);border:1px solid var(--line);color:var(--txt);padding:6px 9px;border-radius:8px;font-size:12.5px;max-width:240px}
  .audsel{display:flex;gap:12px;flex-wrap:wrap;margin:6px 0 14px}
  .audsel label{display:flex;flex-direction:column;gap:4px;font-size:10.5px;color:var(--muted);text-transform:uppercase;letter-spacing:.5px}
  .audsel select{min-width:150px}
  /* kpi cards */
  .kpis{display:grid;grid-template-columns:repeat(auto-fit,minmax(165px,1fr));gap:14px;margin-bottom:20px}
  .kpi{background:var(--panel);border:1px solid var(--line);border-radius:12px;padding:14px 16px;position:relative;overflow:hidden}
  .kpi .k{font-size:11px;color:var(--muted);text-transform:uppercase;letter-spacing:.6px}
  .kpi .v{font-size:24px;font-weight:750;margin-top:6px}
  .kpi .d{font-size:11px;color:var(--muted);margin-top:3px}
  .kpi::after{content:"";position:absolute;right:-20px;top:-20px;width:70px;height:70px;border-radius:50%;background:radial-gradient(circle,rgba(108,140,255,.18),transparent 70%)}
  /* layout */
  .grid{display:grid;gap:18px}
  .g2{grid-template-columns:2fr 1fr}
  .g2e{grid-template-columns:1fr 1fr}
  @media(max-width:1000px){.g2,.g2e{grid-template-columns:1fr}}
  .card{background:var(--panel);border:1px solid var(--line);border-radius:12px;padding:16px}
  .card h3{margin:0 0 4px;font-size:14px;font-weight:700}
  .card .note{color:var(--muted);font-size:11px;margin-bottom:12px}
  .cardhead{display:flex;align-items:flex-start;justify-content:space-between;gap:10px;flex-wrap:wrap}
  .chartbox{position:relative;height:300px}
  .chartbox.sm{height:260px}
  .chartbox.imp{height:230px}
  /* tables */
  table{width:100%;border-collapse:collapse;font-size:12.5px}
  th,td{padding:8px 10px;text-align:right;border-bottom:1px solid var(--line);white-space:nowrap}
  th:first-child,td:first-child{text-align:left}
  th{color:var(--muted);font-weight:600;text-transform:uppercase;font-size:10.5px;letter-spacing:.5px;cursor:pointer;user-select:none;position:sticky;top:0;background:var(--panel)}
  th.sort-asc::after{content:" ▲";color:var(--accent)}
  th.sort-desc::after{content:" ▼";color:var(--accent)}
  tbody tr:hover{background:var(--panel2)}
  .scroll{max-height:460px;overflow:auto;border:1px solid var(--line);border-radius:10px}
  .tag{display:inline-block;padding:2px 8px;border-radius:20px;font-size:11px;background:var(--chip);color:var(--muted)}
  .tag.v{background:rgba(108,140,255,.16);color:#a9bcff}
  .tag.i{background:rgba(33,201,151,.16);color:#7ff0cf}
  .tag.c{background:rgba(255,180,84,.16);color:#ffd39a}
  .mini{font-size:11px;color:var(--muted)}
  .row-actions{display:flex;gap:8px;align-items:center;margin-bottom:10px;flex-wrap:wrap}
  .search{background:var(--panel2);border:1px solid var(--line);color:var(--txt);padding:7px 10px;border-radius:8px;min-width:220px}
  .pill{cursor:pointer;padding:5px 12px;border-radius:20px;border:1px solid var(--line);background:transparent;color:var(--muted);font-size:12px}
  .pill.active{background:var(--accent);color:#0b0e13;border-color:var(--accent);font-weight:700}
  .legend{display:flex;gap:14px;flex-wrap:wrap;font-size:11px;color:var(--muted);margin-top:8px}
  .dot{display:inline-block;width:9px;height:9px;border-radius:50%;margin-right:5px;vertical-align:middle}
  .section-title{font-size:13px;color:var(--muted);text-transform:uppercase;letter-spacing:1px;margin:26px 0 12px;border-left:3px solid var(--accent);padding-left:10px}
  footer{color:var(--muted);font-size:11px;text-align:center;padding:26px}
  .heatcell{color:#0b0e13;font-weight:700;border-radius:5px}
  .breadcrumb{font-size:12px;color:var(--muted);margin-bottom:10px}
  .breadcrumb b{color:var(--txt)}
  .clickable{cursor:pointer;color:#a9bcff}
  .clickable:hover{text-decoration:underline}
</style>
</head>
<body>
<header>
  <div class="brand">
    <div class="logo">Lb</div>
    <div>
      <h1>Littlebox · Meta Ads Performance Dashboard</h1>
      <div class="sub" id="hdrSub">Loading…</div>
    </div>
  </div>
  <div class="sub" id="hdrRange"></div>
</header>

<div class="wrap">
  <!-- FILTERS -->
  <div class="filters">
    <label>From date<input type="date" id="fFrom"></label>
    <label>To date<input type="date" id="fTo"></label>
    <label>Campaign
      <select id="fCampaign"><option value="">All campaigns</option></select>
    </label>
    <label>Ad Set
      <select id="fAdset"><option value="">All ad sets</option></select>
    </label>
    <label>Quick range
      <select id="fQuick">
        <option value="all">All available</option>
        <option value="7">Last 7 days</option>
        <option value="14">Last 14 days</option>
      </select>
    </label>
    <button class="btn" id="apply">Apply</button>
    <button class="btn ghost" id="reset">Reset</button>
  </div>

  <!-- KPI CARDS -->
  <div class="kpis" id="kpis"></div>

  <!-- DAY BY DAY TREND ANALYSIS -->
  <div class="section-title">Day-by-Day Trend Analysis</div>
  <div class="card">
    <h3>Metric Trend (Daily)</h3>
    <div class="note">Pick one or more metrics to plot day by day. Big-scale metrics use the left axis, ratio metrics (ROAS / CTR / CvR / CPC / CPM) the right axis. Respects date, campaign &amp; ad-set filters.</div>
    <div class="row-actions" id="trendPills"></div>
    <div class="chartbox"><canvas id="cTrend"></canvas></div>
  </div>

  <!-- TREND ROW -->
  <div class="grid g2">
    <div class="card">
      <h3>Daily Spend & Revenue</h3>
      <div class="note">Total ad spend vs purchase value per day (INR)</div>
      <div class="chartbox"><canvas id="cSpend"></canvas></div>
    </div>
    <div class="card">
      <h3>Budget Allocation</h3>
      <div class="note">Share of spend by campaign</div>
      <div class="chartbox"><canvas id="cPie"></canvas></div>
    </div>
  </div>

  <div class="grid g2e" style="margin-top:18px">
    <div class="card">
      <h3>CTR & Conversion-Rate Trend</h3>
      <div class="note">Link CTR (%) and conversion rate (%) per day</div>
      <div class="chartbox sm"><canvas id="cRates"></canvas></div>
    </div>
    <div class="card">
      <h3>ROAS & CPC Trend</h3>
      <div class="note">Return on ad spend (x) and cost per click (₹) per day</div>
      <div class="chartbox sm"><canvas id="cRoas"></canvas></div>
    </div>
  </div>

  <!-- AUDIENCE IMPRESSION SHARE -->
  <div class="section-title">Audience Impression Share</div>
  <div class="card">
    <h3>Impression Share by Audience Segment</h3>
    <div class="note">Engaged / Existing / New impression split for the selected Campaign, Ad Set or Ad. Choose any combination below — the most specific selection wins (Ad ▸ Ad Set ▸ Campaign ▸ all). Full date range.</div>
    <div class="audsel">
      <label>Campaign Name<select id="impCampaign" class="cardsel"></select></label>
      <label>Ad Set Name<select id="impAdset" class="cardsel"></select></label>
      <label>Ad Name<select id="impAd" class="cardsel"></select></label>
    </div>
    <div class="grid g2e">
      <div>
        <div class="mini" style="margin-bottom:6px">Aggregate impression share</div>
        <div class="chartbox imp"><canvas id="cImpShare"></canvas></div>
      </div>
      <div>
        <div class="mini" style="margin-bottom:6px">Day-by-day impressions (stacked by audience)</div>
        <div class="chartbox imp"><canvas id="cImpDaily"></canvas></div>
      </div>
    </div>
    <div class="legend">
      <span><span class="dot" style="background:var(--aud1)"></span>Engaged Audience</span>
      <span><span class="dot" style="background:var(--aud2)"></span>Existing Audience</span>
      <span><span class="dot" style="background:var(--aud3)"></span>New Audience</span>
      <span class="mini" id="impScope" style="margin-left:auto"></span>
    </div>
  </div>

  <!-- AUDIENCE + CREATIVE -->
  <div class="section-title">Segment &amp; Creative Performance</div>
  <div class="grid g2e">
    <div class="card">
      <h3>Audience Segment Performance</h3>
      <div class="note">Spend, conversion value, ROAS &amp; rates by targeting segment for the selected Campaign, Ad Set or Ad (most specific selection wins · full range)</div>
      <div class="audsel">
        <label>Campaign Name<select id="audCampaign" class="cardsel"></select></label>
        <label>Ad Set Name<select id="audAdset" class="cardsel"></select></label>
        <label>Ad Name<select id="audAd" class="cardsel"></select></label>
      </div>
      <div class="mini" id="audScope" style="margin-bottom:8px"></div>
      <div class="scroll" style="max-height:240px"><table id="tAud"></table></div>
    </div>
    <div class="card">
      <h3>Creative Type Performance</h3>
      <div class="note">By ad format, parsed from ad naming · incl. conversion value (full range)</div>
      <div class="scroll" style="max-height:240px"><table id="tCre"></table></div>
    </div>
  </div>

  <!-- AD SET HEATMAP -->
  <div class="section-title">Ad Set Heatmap</div>
  <div class="card">
    <h3>Ad Set Performance Matrix</h3>
    <div class="note">Color-graded by column (green = better, red = worse). Click an ad set to drill into its ads. Respects date + campaign filters.</div>
    <div class="scroll"><table id="tHeat"></table></div>
    <div class="legend">
      <span><span class="dot" style="background:var(--good)"></span>Stronger</span>
      <span><span class="dot" style="background:var(--warn)"></span>Mid</span>
      <span><span class="dot" style="background:var(--bad)"></span>Weaker</span>
    </div>
  </div>

  <!-- AD LEVEL TABLE -->
  <div class="section-title">Ad-Level Explorer</div>
  <div class="card">
    <div class="breadcrumb" id="crumb"></div>
    <div class="row-actions">
      <input class="search" id="adSearch" placeholder="Search ad name…">
      <span class="mini">Creative:</span>
      <button class="pill active" data-cre="">All</button>
      <button class="pill" data-cre="Video">Video</button>
      <button class="pill" data-cre="Image">Image</button>
      <button class="pill" data-cre="Image Collection">Image Collection</button>
      <span class="mini" id="adCount"></span>
    </div>
    <div class="scroll"><table id="tAds"></table></div>
    <div class="note" style="margin-top:8px">Ad-level metrics are aggregated over the full date range (ad-day granularity not exported at this level). Campaign &amp; ad-set drill-down and creative/search filters apply.</div>
  </div>

  <footer>
    Generated by Littlebox Meta Ads Analytics · Data: Campaign / Ad Set / Ad level exports ·
    Spend &amp; revenue authoritative at campaign level · <span id="footMeta"></span>
  </footer>
</div>

